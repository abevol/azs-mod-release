# Azeroth Survivors 等级/天赋/幸运品质模组配置示例
#
# 用法：把本文件复制为 azs-mod.toml（与 azs_mod.dll 同目录）后按需修改。
# 游戏启动时读取一次；游戏内菜单（右侧 MODS → AZS）点"应用"会把生效值写回
# azs-mod.toml，因此那个文件是运行期产物，不进版本控制。
#
# 本文件里的值是**内置默认值**：azs-mod.toml 不存在时，DLL 用的就是这些。

# 是否写过程日志（补丁足迹、扫描结果、桥连接情况）
# 默认关闭。`[!]` 开头的告警不受此开关约束，永远写入——
# 补丁没打上/锚点失效若静默，只会看到功能莫名不生效，排查成本更高。
log = false

# 局内等级上限（这一局的玩家等级 / XP 条封顶，原版 99）
run_level_cap = 200

# 天赋总点数上限（原版 51）
# 机制：天赋经验→点数换算在二进制中有 17 份拷贝（9 职业×存档加载、结算发点、
# UI 判断等），结构为：起始 2 点 + 每层 3 系各 1 点、层阈值 110 起每层 +45、
# 循环界 875=110+45×17、封顶 51。
# 模组按公式同步改写全部拷贝：循环界 = 110 + 45×(cap/3)。
# 注意：cap 需为 3~127（钳制指令 imm8 与存档 u8 字段限制；51/99/100 均可）。
talent_cap = 100

# ---------------------------------------------------------------------------
# 高级：自定义补丁槽。以后定位到新的常量时，无需重新编译，直接加一段即可。
# expect 为版本守护：当前值不等于 expect 时自动跳过（防止游戏更新后写坏内存）。
#
# [[patch]]
# name = "示例：某常量"
# rva = 0x0        # 相对主模块基址的偏移
# size = 4         # 1/2/4/8 字节
# expect = 0x33    # 原值（守护）
# value = 0x64     # 新值
# enabled = true
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 技能描述显示冷却时间（默认开启）
#
# 升级卡片的技能描述由「升级选项构建器」单独生产，与 HUD 上每帧重算的描述链
# 是两条路。模组只改卡片那条：在描述最前面插入一行「X秒冷却」，纯文本。
# 冷却读自技能表条目 +0x48（f32 秒）。
#
# 容量不足时借用游戏自己的 String 扩容函数，不触碰我们自己的分配器。
# ---------------------------------------------------------------------------
cooldown = true

# ---------------------------------------------------------------------------
# 幸运品质保底（v6 新增，默认开启）
#
# 机制（对 v0.119.0 逆向）：升级选项/守卫·宝箱装备/存档恢复的品质 roll 公式为
#   权重 [普通 60, 优秀 25x, 稀有 10x², 史诗 4x³, 传说 x⁴]，x = 1 + min(幸运%, 30)/100
#   roll 落在普通段（<60）时品质为普通。
# 模组在"普通判定"处注入逻辑：幸运达到阈值后，普通段 roll 直接抬到下限品质。
#   ≥luck_t1：不再出现普通；≥luck_t2：不再出现优秀及以下；≥luck_t3：不再出现稀有及以下。
# 扫描定位：以品质公式常量（0.01/0.30）+ RNG 调用 + 判定指令结构定位，全部动态解析。
# ---------------------------------------------------------------------------
luck_quality = true
luck_t1 = 60
luck_t2 = 90
luck_t3 = 140
